<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6D9FF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:paddingTop="60dp"
        android:paddingBottom="60dp">

        <TextView
            android:id="@+id/textViewWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textViewPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Points: loading..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5A189A"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonViewRideOffers"
            style="@style/RideAppButton"
            android:text="View Ride Offers" />

        <Button
            android:id="@+id/buttonViewRideRequests"
            style="@style/RideAppButton"
            android:text="View Ride Requests" />

        <Button
            android:id="@+id/buttonPostRide"
            style="@style/RideAppButton"
            android:text="Post Ride" />

        <Button
            android:id="@+id/buttonPostRequest"
            style="@style/RideAppButton"
            android:text="Post Request" />

        <Button
            android:id="@+id/buttonManageRides"
            style="@style/RideAppButton"
            android:text="Manage My Rides" />

        <Button
            android:id="@+id/buttonLogout"
            style="@style/RideAppButton"
            android:text="Logout"
            android:backgroundTint="@android:color/holo_red_light" />
    </LinearLayout>
</ScrollView>
